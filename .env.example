# Copy to .env and fill in. Never commit .env.

# dev | staging | prod
TALENT_ENV=dev

# Paths to data held outside the repository (docs/DATA_HANDLING.md)
TALENT_MASTER_PATH=
TALENT_EVAL_PATH=
# Reconciliation output folder: holds a candidate-data sample, so it must be outside the repository
TALENT_RECONCILE_DIR=
# The Docker tools run as this user, so private (chmod 700) data folders work.
# Set to the output of `id -u` and `id -g`.
TALENT_UID=1000
TALENT_GID=1000

# Database. The API connects as talent_app, which cannot change or delete raw captures.
# Migrations run as the owner. docker compose builds the in-network DSNs from the passwords.
TALENT_DB_OWNER_PASSWORD=
TALENT_DB_APP_PASSWORD=
TALENT_DB_DSN=
TALENT_DB_MIGRATION_DSN=

# Model serving — shared host, see NFR-01
TALENT_LLM_BASE_URL=http://localhost:8061/v1
TALENT_OCR_BASE_URL=http://localhost:8100/v1
TALENT_EMBED_BASE_URL=http://localhost:8041/v1
TALENT_LLM_MAX_CONCURRENCY=4
TALENT_BATCH_WINDOW_START=22:00
TALENT_BATCH_WINDOW_END=06:00
TALENT_TIMEZONE=Africa/Cairo

# Reading CVs (docs/intake/OCR_ANSWER.md). fake = saved samples, dev only; api = the OCR API on our
# own host. Left empty: fake in dev, api elsewhere. Limits are safe defaults until the OCR team
# gives its numbers.
TALENT_OCR_MODE=
TALENT_OCR_API_KEY=
TALENT_OCR_TIMEOUT_SECONDS=60
TALENT_OCR_MAX_CONCURRENCY=2
TALENT_OCR_MAX_ATTEMPTS=4
# The CV test set and its labels.json, outside the repository (docs/intake/CV_TEST_SET.md)
TALENT_CV_TEST_SET=

# Storage
TALENT_BLOB_ENDPOINT=
TALENT_BLOB_BUCKET=talent-raw
TALENT_BLOB_ACCESS_KEY=
TALENT_BLOB_SECRET_KEY=
TALENT_VECTOR_URL=
TALENT_REDIS_URL=

# Sign-in with company accounts (NFR-09)
TALENT_OIDC_ISSUER=
TALENT_OIDC_AUDIENCE=
# oidc = company identity provider. dev = fake accounts from POST /dev/token;
# the API refuses to start in dev mode when TALENT_ENV is staging or prod.
TALENT_AUTH_MODE=oidc

# Local compose: the one published port, bound to 127.0.0.1
TALENT_API_PORT=8090

# Security — no default is provided on purpose
TALENT_JWT_SECRET=

# Events to the CRM by webhook (API plan section 7). Leave empty to keep delivery off.
# The URL must be https; the shared secret at least 32 random characters, never committed.
TALENT_CRM_WEBHOOK_URL=
TALENT_CRM_WEBHOOK_SECRET=

# Backups (week 7). The dump holds every candidate's history, so the directory lives outside any
# git repository, exactly like the master workbook. The dump is taken as the owner role, so that
# it is complete. Tools: "local" uses the pg_dump on PATH, "docker:postgres" runs the ones inside
# the compose service — they must match the server's version.
TALENT_BACKUP_DIR=
TALENT_BACKUP_DSN=
TALENT_BACKUP_TOOLS=local
